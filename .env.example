# App
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
PLATFORM_DOMAIN=localhost

# PostgreSQL & Redis via Docker (make infra-up)
# Port 5433/6380 di host — tidak bentrok dengan PostgreSQL/Redis lokal Mac (5432/6379)
DATABASE_URL=postgres://owncommerce:owncommerce@localhost:5433/owncommerce?sslmode=disable
REDIS_URL=redis://localhost:6380/0

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Local file storage (path relatif dari apps/api saat make api-dev)
STORAGE_PATH=../../storage

# Midtrans (sandbox) — daftar di https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=your-sandbox-server-key
MIDTRANS_CLIENT_KEY=your-sandbox-client-key
MIDTRANS_IS_PRODUCTION=false
