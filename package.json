{
  "name": "owncommerce",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "make -C apps/api dev",
    "dev:infra": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "dev:infra:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  }
}
